modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "gce"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "review-integration"

[[workflows.workflow]]
name = "review-integration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:review-integration"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ADMIN_IDS = "8913389274"

[userenv.development]
TELEGRAM_DEV_BOT_ENABLED = "false"
TELEGRAM_SHARED_API_URL = "https://telegram-access-key-api.replit.app/api"

[nix]
channel = "stable-25_05"
